{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "group:allNonMajor"],
  "enabledManagers": ["npm", "github-actions"],
  "dependencyDashboardApproval": true,
  "vulnerabilityAlerts": {
    "dependencyDashboardApproval": false
  },
  "platformCommit": "enabled",
  "semanticCommits": "disabled",
  "packageRules": [
    {
      "description": "Apply the same cooldown to GitHub Actions as npm dependencies",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Bump @types/node major manually to match the Node.js version in devEngines.runtime, which Renovate cannot update yet (renovatebot/renovate#38067)",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
