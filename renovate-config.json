{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:best-practices", "group:allNonMajor", ":automergeMinor"],
  "ignorePresets": ["abandonments:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "platformCommit": "enabled",
  "postUpdateOptions": ["pnpmDedupe"],
  "semanticCommits": "disabled",

  "enabledManagers": ["npm", "github-actions", "git-submodules", "custom.jsonata"],
  "git-submodules": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Update devEngines.runtime in package.json",
      "customType": "jsonata",
      "fileFormat": "json",
      "managerFilePatterns": ["/(^|/)package\\.json$/"],
      "matchStrings": [
        "devEngines.runtime.name = \"node\" ? [{ \"depName\": \"node\", \"currentValue\": devEngines.runtime.version, \"datasource\": \"node-version\", \"versioning\": \"node\" }] : []"
      ]
    }
  ],

  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Git submodules have no release timestamp; do not wait for a release age",
      "matchManagers": ["git-submodules"],
      "minimumReleaseAge": null
    },
    {
      "description": "Batch minor and patch updates weekly; everything else is raised as soon as it is available",
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["* 12-17 * * 5"]
    },
    {
      "description": "First-party packages and actions; update immediately in their own group",
      "matchPackageNames": ["@iorate/*", "@ublacklist/*", "iorate/*"],
      "groupName": "first-party packages",
      "minimumReleaseAge": null,
      "schedule": null
    },
    {
      "description": "Track Node.js Current releases instead of waiting for LTS",
      "matchJsonata": ["versioning = 'node'"],
      "ignoreUnstable": false,
      "allowedVersions": "!/-/"
    }
  ],
  "lockFileMaintenance": {
    "schedule": ["* 18-23 * * 5"]
  }
}
